# ─── Internal API auth ───
# Required in production for /api/import, /api/search, /api/trends, /api/scrape.
# If unset in prod, those routes return 503 (api disabled).
# Clients must send `x-pv-secret: <value>` header.
PV_API_SECRET=cambiar-esto-en-prod

# ─── Scraper kill-switch (Puppeteer) ───
# /api/scrape is dev-only by default. Set to "true" in Vercel only when
# you intentionally want to enable Puppeteer-driven scraping in prod.
ENABLE_SCRAPE=false

# ─── MercadoLibre page scraper/importer ───
# Default importer source is the no-API page scraper. Set to "api" only if you
# have a working MercadoLibre API token and want to use lib/mercadolibre.ts.
ML_IMPORT_SOURCE=scraper

# When MercadoLibre asks for verification, run once in headful mode with a
# persistent profile so Chromium can keep the solved session cookies.
ML_SCRAPER_HEADFUL=false
ML_SCRAPER_PROFILE_DIR=.cache/ml-scraper-profile

# ─── MercadoLibre OAuth ───
# Used by lib/mercadolibre.ts when calling endpoints that require auth
# (e.g. /trends/MLA). Public endpoints fall through without it.
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_APP_ID=
ML_SECRET=

# ─── Site config ───
NEXT_PUBLIC_SITE_URL=https://productosvirales.com.ar
NEXT_PUBLIC_GA_ID=
