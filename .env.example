# ─── Internal API auth ───
# Required in production for /api/import, /api/search, /api/trends, /api/scrape.
# If unset in prod, those routes return 503 (api disabled).
# Clients must send `x-pv-secret: <value>` header.
PV_API_SECRET=cambiar-esto-en-prod

# ─── Scraper kill-switch (Puppeteer) ───
# /api/scrape is dev-only by default. Set to "true" in Vercel only when
# you intentionally want to enable Puppeteer-driven scraping in prod.
ENABLE_SCRAPE=false

# ─── MercadoLibre page scraper/importer ───
# Default importer source is the no-API page scraper. Set to "api" only if you
# have a working MercadoLibre API token and want to use lib/mercadolibre.ts.
ML_IMPORT_SOURCE=scraper

# When MercadoLibre asks for verification, run once in headful mode with a
# persistent profile so Chromium can keep the solved session cookies.
ML_SCRAPER_HEADFUL=false
ML_SCRAPER_PROFILE_DIR=.cache/ml-scraper-profile

# ─── MercadoLibre OAuth ───
# Used by lib/mercadolibre.ts when calling endpoints that require auth
# (e.g. /trends/MLA). Public endpoints fall through without it.
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_APP_ID=
ML_SECRET=

# ─── Base de datos (captación de emails) ───
# Postgres de Neon (vía Vercel → Storage). La integración de Neon inyecta
# DATABASE_URL automáticamente en Vercel. Para probar en local, pegá acá la
# connection string (la "pooled", la que termina en ...-pooler...).
# Si queda vacía, /api/subscribe NO guarda nada (solo loguea) y no rompe.
DATABASE_URL=

# ─── Site config ───
NEXT_PUBLIC_SITE_URL=https://productosvirales.com.ar
NEXT_PUBLIC_GA_ID=

# ─── Instagram Graph API (publicación automática de posts/historias) ───
# Cuenta Business/Creator vinculada a una Página de Facebook, app creada en
# developers.facebook.com con el producto "Instagram" agregado. Token con
# permisos instagram_basic + instagram_content_publish, dura 60 días.
# Ver scripts/publicar-instagram.cjs.
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# ─── Vercel Blob (hosting público de las imágenes generadas para IG) ───
# La Instagram Graph API exige que la imagen esté en una URL pública, no
# admite subir el archivo directo. Activar en Vercel → proyecto → Storage →
# Blob; el token se genera solo.
BLOB_READ_WRITE_TOKEN=

# ─── AI-OS review agents ───
# Usado por scripts/ai-os/review-guide.sh para consultar Gemini en modo
# headless y Claude en modo no interactivo. No commitear claves reales.
ANTHROPIC_AUTH_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_OS_AGENT_TIMEOUT_SECONDS=90
CODEX_TIMEOUT_SECONDS=120

# ─── Canal de WhatsApp (Baileys, cliente NO oficial) ───
# No existe API de Meta para publicar en Channels. Ver scripts/whatsapp-bootstrap.mjs
# y scripts/publicar-whatsapp-canal.cjs. Riesgo de baneo del número asumido.
#
# Sesión de login persistida encriptada en Neon (tabla whatsapp_channel_session,
# scripts/db/006_whatsapp_channel.sql) porque GitHub Actions no tiene disco
# persistente entre corridas.
#
# WHATSAPP_SESSION_KEY: 32 bytes en base64, generar UNA vez con
# `openssl rand -base64 32` y no volver a cambiarla (invalidaría la sesión).
WHATSAPP_SESSION_KEY=
# WHATSAPP_CHANNEL_JID: lo imprime scripts/whatsapp-bootstrap.mjs al final,
# a partir del link de invitación del canal.
WHATSAPP_CHANNEL_JID=
